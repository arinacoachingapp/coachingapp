{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/career/generate-role-card.js": {
      "maxDuration": 60
    },
    "api/career/interview-turn.js": {
      "maxDuration": 60
    },
    "api/career/speak.js": {
      "maxDuration": 60
    },
    "api/career/transcribe.js": {
      "maxDuration": 60
    },
    "api/admin/me.js": {
      "maxDuration": 30
    },
    "api/admin/settings.js": {
      "maxDuration": 30
    },
    "api/admin/prompts.js": {
      "maxDuration": 30
    },
    "api/admin/admins.js": {
      "maxDuration": 30
    },
    "api/admin/[...path].js": {
      "maxDuration": 30
    }
  }
}
