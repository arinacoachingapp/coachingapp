{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/admin/prompts/:path*", "destination": "/api/admin/prompt-item?path=:path*" },
    { "source": "/api/admin/admins/:path*", "destination": "/api/admin/admin-item?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/career/generate-role-card.js": {
      "maxDuration": 60
    },
    "api/career/interview-turn.js": {
      "maxDuration": 60
    },
    "api/career/speak.js": {
      "maxDuration": 60
    },
    "api/career/transcribe.js": {
      "maxDuration": 60
    },
    "api/admin/me.js": {
      "maxDuration": 30
    },
    "api/admin/settings.js": {
      "maxDuration": 30
    },
    "api/admin/prompts/index.js": {
      "maxDuration": 30
    },
    "api/admin/prompt-item.js": {
      "maxDuration": 30
    },
    "api/admin/admins/index.js": {
      "maxDuration": 30
    },
    "api/admin/admin-item.js": {
      "maxDuration": 30
    }
  }
}
