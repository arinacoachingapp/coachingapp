VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SITE_URL=http://localhost:5173

# Chat + Whisper STT (same key)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_STT_MODEL=openai/whisper-1
# OPENROUTER_POLISH_MODEL=openai/gpt-4o-mini
# OPENROUTER_POLISH_TRANSCRIPT=always

# Neural TTS (server-only — must also be set in Vercel env, not just .env)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Used only as server fallback when the client does not send a voiceId.
# In the app, users pick from: Alexandra, Brian, Mark, Cassidy, Lauren, Ben.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
